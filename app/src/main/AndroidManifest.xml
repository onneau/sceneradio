<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- De zes functionele permissies voor de radio, plus REQUEST_INSTALL_PACKAGES voor de update-functie -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Nodig om een gedownloade update van de app zelf aan het installatiescherm van Android te geven -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Leanback en Touchscreen als optioneel gemarkeerd voor universele ondersteuning -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SceneRadioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.SceneRadio"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- Android Auto integratie metadata -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Telefoon & Tablet hoofdactiviteit -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SceneRadio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aparte Android TV & Google TV activiteit met LEANBACK_LAUNCHER -->
        <activity
            android:name=".ui.tv.TvActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SceneRadio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaLibraryService voor Android Auto en achtergrondafspelen -->
        <service
            android:name=".playback.RadioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- Zenderlogo's voor Android Auto: Android Auto laadt alleen content://-plaatjes, geen web-adressen.
             Alleen lezen, en alleen logo's van zenders in de eigen lijst. -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <!-- Geeft een gedownloade update (alleen uit de updates-map in de cache) aan het installatiescherm van Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
